# 2. 다음 코드의 실행 결과를 작성하시오
try:
    x = int("abc")
except ValueError:
    print("ValueError occurred!")
finally:
    print("Execution finished.")

# ValueError occurred!
# Execution finished.
# 문자열을 정수형으로 바꿀 수 없으므로 ValueError가 발생한다. 그래서 except 절이 실행되고 finally 절은 예외와 상관없이 실행된다.



